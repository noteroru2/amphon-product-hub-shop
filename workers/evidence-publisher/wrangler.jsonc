{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amphon-evidence-publisher",
  "main": "index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "STAGED_IMAGES",
      "bucket_name": "amphon-evidence-staged-private"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://hub.amphon.co.th"
  }
}
