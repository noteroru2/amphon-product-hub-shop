{
  "name": "amphon-ai-buyer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "amphon-product-images"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION_BATCHER",
        "class_name": "ConversationBatcher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationBatcher"]
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://mfpdtlxwdbxitgfzdape.supabase.co",
    "AI_BUYER_ENV": "production",
    "AI_BUYER_BATCH_DEBOUNCE_MS": "2500",
    "OPENAI_VISION_MODEL": "gpt-5.6-sol",
    "OPENAI_PRICING_MODEL": "gpt-5.6-sol"
  }
}
