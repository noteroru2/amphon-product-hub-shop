{
  "version": "AMPHON_AI_BUYER_OPTIMIZATION_V1",
  "effectiveDate": "2026-09-22",
  "runtime": {
    "aiPausedDuringOptimization": true,
    "lineWebhookCollectionContinues": true,
    "outboundAiRepliesAllowed": false,
    "objective": "Do not block pricing on non-essential photos. Price from sufficient model/spec evidence, preserve defects, and escalate only material ambiguity/risk."
  },
  "global": {
    "evidencePriority": [
      "CONFIRMED_TEXT",
      "READABLE_MODEL_LABEL",
      "ABOUT_OR_SYSTEM_SCREEN",
      "CONFIRMED_IMAGE",
      "INFERRED"
    ],
    "rules": {
      "neverAskForSameEvidenceTwice": true,
      "photosAreOptionalWhenPricingEvidenceSufficient": true,
      "unknownConditionDoesNotEraseKnownDefects": true,
      "knownDefectMustAdjustOrEscalate": true,
      "multipleDeviceAmbiguityRequiresReview": true,
      "conflictingModelOrSpecRequiresReview": true,
      "priceBookFirst": true,
      "marketFallbackWhenNoReliablePriceBookMatch": true,
      "priceGuardHardMaxAlwaysAuthoritative": true
    },
    "reasonCodes": [
      "READY_BY_COMPLETE_SPEC",
      "READY_BY_MODEL_IDENTITY",
      "READY_BY_MODEL_CODE",
      "MISSING_PRODUCT_TYPE",
      "MISSING_MODEL",
      "MISSING_STORAGE_VARIANT",
      "MISSING_CORE_SPEC",
      "MODEL_SPEC_CONFLICT",
      "MULTIPLE_DEVICES_AMBIGUOUS",
      "MODEL_VARIANT_AMBIGUOUS",
      "BATTERY_BAD",
      "KNOWN_DEFECT_ADJUSTED",
      "MAJOR_DAMAGE",
      "DEVICE_NOT_BOOTING",
      "LOCKED",
      "MARKET_COMPARABLES_INSUFFICIENT",
      "HUMAN_REVIEW_REQUIRED"
    ]
  },
  "categories": {
    "NOTEBOOK": {
      "readiness": {
        "primaryPath": {
          "type": "SPEC",
          "minIdentityConfidence": 0.8,
          "required": [
            "brand",
            "series_or_model",
            "cpu",
            "gpu_or_integrated",
            "ram",
            "storage"
          ]
        },
        "fallbackPath": {
          "type": "MODEL_MARKET",
          "minIdentityConfidence": 0.9,
          "requiresExactModelCode": true,
          "minSpecCompletenessWithModelCode": 0.35,
          "minSpecCompletenessWithModelNameOnly": 0.6
        },
        "nonBlocking": [
          "charger_photo",
          "accessories_photo",
          "battery_health",
          "cosmetic_angles"
        ]
      },
      "askOnlyWhenMissing": [
        "model_or_series",
        "cpu",
        "gpu",
        "ram",
        "storage"
      ],
      "adjustmentsThb": {
        "BATTERY_BAD": -800,
        "NO_CHARGER": -500,
