  "batteryPolicy": {
    "badThresholdPercentExclusive": 80,
    "textualSignals": [
      "significantly degraded",
      "service recommended",
      "แบตเสื่อม",
      "ไม่เก็บไฟ",
      "หมดไว"
    ],
    "rule": "If known bad, BATTERY_BAD must survive future analyses and price must be adjusted or escalated."
  },
  "acceptance": {
    "completeSpecStillWaitingForPhoto": 0,
    "clearModelStillUnidentified": 0,
    "knownBatteryBadPricedAsNormal": 0,
    "duplicateEvidenceRequests": 0,
    "targetAutoPriceRateMin": 0.4,
    "targetHumanReviewRateMax": 0.3
  }
