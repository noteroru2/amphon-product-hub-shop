---
import { indexCategories } from '../config/catalog'
import { primaryLineId, primaryLineUrl } from '../lib/contact'
import { absoluteUrl } from '../lib/seo'
import '../styles/global.css'
import '../styles/auth.css'
import '../styles/mobile-first.css'
import '../styles/storefront-human.css'
import '../styles/line-first.css'

interface Props {
  title: string
  description: string
  canonicalPath?: string
  robots?: string
  jsonLd?: unknown | unknown[]
  ogImage?: string | null
  ogType?: 'website' | 'product'
  productMeta?: { price: number; currency: string; availability: string; condition: string } | null
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  robots = 'index,follow,max-image-preview:large',
  jsonLd,
  ogImage = null,
  ogType = 'website',
  productMeta = null,
} = Astro.props

const canonical = absoluteUrl(canonicalPath)
const schemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="amphon-deploy-verification" content="shop-auto-deploy-20260913" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="AMPHON SHOP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {productMeta && <meta property="product:price:amount" content={String(productMeta.price)} />}
    {productMeta && <meta property="product:price:currency" content={productMeta.currency} />}
    {productMeta && <meta property="product:availability" content={productMeta.availability} />}
    {productMeta && <meta property="product:condition" content={productMeta.condition} />}
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body data-line-url={primaryLineUrl} data-line-id={primaryLineId}>
    <a class="skip-link" href="#main-content">ข้ามไปยังเนื้อหาหลัก</a>
    <header class="site-header">
      <div class="container header-row">
        <a class="logo" href="/" aria-label="AMPHON SHOP หน้าแรก">
          <span class="logo-mark">A</span>
          <span>AMPHON SHOP</span>
        </a>
        <nav class="nav" aria-label="หมวดสินค้าหลัก">
          {indexCategories.slice(0, 7).map((category) => (
            <a href={`/${category.slug}/`}>{category.navName}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="header-line-link" href={primaryLineUrl} target="_blank" rel="nofollow noopener" aria-label={`ซื้อหรือสอบถามผ่าน LINE ${primaryLineId}`}>LINE {primaryLineId}</a>
          <a class="account-link" href="/account/" aria-label="บัญชีของฉัน">บัญชี</a>
          <a class="account-link orders-link" href="/account/orders/" aria-label="รายการสั่งซื้อของฉัน">รายการสั่งซื้อ</a>
          <a class="cart-link" href="/cart/" aria-label="ตะกร้าสินค้า">ตะกร้า <span id="cart-count">0</span></a>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-row">
        <div>
          <strong>AMPHON TRADING</strong>
          <div class="footer-small">เลือกของมือสองจากรูปและรายละเอียดของชิ้นจริง ถ้ามีจุดไหนไม่แน่ใจ ติดต่อร้านก่อนสั่งซื้อได้เสมอ</div>
          <div class="footer-line-box">
            <a class="button-line" href={primaryLineUrl} target="_blank" rel="nofollow noopener">ซื้อ / สอบถามผ่าน LINE {primaryLineId}</a>
            <span class="footer-small">LINE เป็นช่องทางหลักของร้าน ส่วนการสั่งซื้อและชำระผ่านเว็บยังใช้งานได้เป็นทางเลือก</span>
          </div>
        </div>
        <div class="footer-small">© {new Date().getFullYear()} AMPHON TRADING</div>
      </div>
    </footer>
    <script>
      import { CART_EVENT, readCartSkus } from '../lib/cart'
      const updateCartCount = () => {
        const target = document.getElementById('cart-count')
        if (target) target.textContent = String(readCartSkus().length)
      }
      updateCartCount()
      window.addEventListener(CART_EVENT, updateCartCount)
      window.addEventListener('storage', updateCartCount)

      // LINE-first commerce UX. Keep the existing web checkout fully available,
      // but present LINE @webuy as the first purchase/contact action.
      const purchaseActions = document.querySelector('.purchase-actions') as HTMLElement | null
      if (purchaseActions) {
        const lineUrl = document.body.dataset.lineUrl || 'https://line.me/R/ti/p/@webuy'
        const lineId = document.body.dataset.lineId || '@webuy'
        const links = Array.from(purchaseActions.querySelectorAll<HTMLAnchorElement>('a'))
        let lineAction = links.find((link) => link.href.includes('line.me') || (link.textContent || '').includes('LINE')) || null

        if (!lineAction) {
          lineAction = document.createElement('a')
          lineAction.href = lineUrl
          lineAction.target = '_blank'
          lineAction.rel = 'nofollow noopener'
          purchaseActions.prepend(lineAction)
        }

        lineAction.classList.remove('button-primary', 'button-secondary')
        lineAction.classList.add('button', 'button-line', 'button-wide', 'line-primary-purchase')
        lineAction.textContent = `ซื้อผ่าน LINE ${lineId}`

        if (!purchaseActions.querySelector('.line-purchase-note')) {
          const note = document.createElement('p')
          note.className = 'line-purchase-note'
          const sku = (document.getElementById('add-to-cart') as HTMLElement | null)?.dataset.sku || ''
          note.innerHTML = `ช่องทางหลักของร้าน — ทัก LINE แล้วแจ้ง${sku ? `รหัสสินค้า <strong>${sku}</strong>` : 'รหัสสินค้า'} เพื่อให้ร้านเช็กสถานะก่อนชำระได้ครับ`
          lineAction.insertAdjacentElement('afterend', note)
        }

        const addToCart = document.getElementById('add-to-cart')
        if (addToCart) {
          addToCart.classList.remove('button-primary')
          addToCart.classList.add('button-secondary', 'web-purchase-secondary')
          addToCart.textContent = 'ใส่ตะกร้า (ชำระผ่านเว็บ)'
        }

        const cartAction = purchaseActions.querySelector<HTMLAnchorElement>('a[href="/cart/"]')
        if (cartAction) {
          cartAction.classList.remove('button-primary')
          cartAction.classList.add('button-secondary', 'web-purchase-secondary')
          cartAction.textContent = 'ไปตะกร้า / ชำระผ่านเว็บ'
        }
      }
    </script>
  </body>
</html>
