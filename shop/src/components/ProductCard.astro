---
import type { StoreProduct } from '../lib/store-api'
import { formatPrice, productPath } from '../lib/seo'

interface Props { product: StoreProduct }
const { product } = Astro.props
const cover = [...product.images].sort((a, b) => Number(b.isCover) - Number(a.isCover) || a.sortOrder - b.sortOrder)[0]
---
<a class="product-card" href={productPath(product)}>
  <div class="product-image">
    {cover?.url ? (
      <img src={cover.url} alt={`${product.title} มือสอง`} loading="lazy" decoding="async" />
    ) : (
      <span class="product-placeholder">ยังไม่มีรูปสินค้า</span>
    )}
  </div>
  <div class="product-body">
    <span class:list={['badge', product.availability === 'reserved' && 'badge-reserved']}>
      {product.availability === 'reserved' ? 'ติดจอง' : 'พร้อมจำหน่าย'}
    </span>
    <h3 class="product-title">{product.title}</h3>
    <div class="product-meta">
      {[product.brand, product.model, product.conditionPercent ? `สภาพ ${product.conditionPercent}%` : null].filter(Boolean).join(' • ')}
    </div>
    <div class="product-price">{formatPrice(product.price)}</div>
  </div>
</a>
