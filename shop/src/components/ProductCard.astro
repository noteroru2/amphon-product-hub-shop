---
import type { StoreProduct } from '../lib/store-api'
import { formatPrice, productPath } from '../lib/seo'
import { productImageSeoText } from '../lib/product-trust'

interface Props { product: StoreProduct; priority?: boolean }
const { product, priority = false } = Astro.props
const cover = [...product.images].sort((a, b) => Number(b.isCover) - Number(a.isCover) || a.sortOrder - b.sortOrder)[0]
---
<a class="product-card" href={productPath(product)}>
  <div class="product-image">
    {cover?.url ? (
      <img src={cover.url} alt={productImageSeoText(product, cover, 0).alt} width={cover.width || 640} height={cover.height || 480} sizes="(max-width: 720px) 50vw, (max-width: 1100px) 33vw, 280px" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
    ) : (
      <span class="product-placeholder">ยังไม่มีรูป</span>
    )}
  </div>
  <div class="product-body">
    <div class="product-card-topline">
      <span class:list={['badge', product.availability === 'reserved' && 'badge-reserved', product.availability === 'out_of_stock' && 'badge-out-of-stock']}>
        {product.availability === 'out_of_stock' ? 'สินค้าหมด' : product.availability === 'reserved' ? 'มีคนจองแล้ว' : 'พร้อมขาย'}
      </span>
      <span class="product-image-count">รูปจริง {product.images.length} รูป</span>
    </div>
    <h3 class="product-title">{product.title}</h3>
    <div class="product-meta">
      {[product.brand, product.model, product.conditionPercent ? `สภาพ ${product.conditionPercent}%` : null].filter(Boolean).join(' • ')}
    </div>
    <div class="product-sku">รหัสสินค้า {product.sku}</div>
    <div class="product-price">{product.availability === 'out_of_stock' && <small>ราคาล่าสุด </small>}{formatPrice(product.price)}</div>
    <span class="product-card-cta">{product.availability === 'out_of_stock' ? 'ดูสเปกและสินค้าที่ใกล้เคียง →' : product.availability === 'reserved' ? 'ดูรายละเอียดสินค้าที่จองแล้ว →' : 'ดูรายละเอียด • ซื้อผ่าน LINE ได้ →'}</span>
  </div>
</a>
