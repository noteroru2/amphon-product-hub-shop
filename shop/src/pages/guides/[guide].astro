---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BuyingResources from '../../components/BuyingResources.astro'
import { buyingGuides, guidePath } from '../../config/buying-guides'
import { getCategoryBySlug } from '../../config/catalog'
import { absoluteUrl } from '../../lib/seo'
import { MAIN_ORGANIZATION_ID } from '../../config/ecosystem'
const guide = buyingGuides.find((item) => item.slug === Astro.params.guide)
if (!guide) { Astro.response.status = 404 }
const title = guide ? `${guide.title} | AMPHON SHOP` : 'ไม่พบคู่มือ | AMPHON SHOP'
const path = guide ? guidePath(guide.slug) : Astro.url.pathname
const schema = guide ? [
  { '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description: guide.answer, mainEntityOfPage: absoluteUrl(path), datePublished: '2026-10-06', author: { '@type': 'Organization', '@id': MAIN_ORGANIZATION_ID, name: 'AMPHON TRADING', url: 'https://amphon.co.th/' }, publisher: { '@id': MAIN_ORGANIZATION_ID } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: guide.faqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: absoluteUrl('/') }, { '@type': 'ListItem', position: 2, name: 'คู่มือเลือกซื้อ', item: absoluteUrl('/guides/') }, { '@type': 'ListItem', position: 3, name: guide.title, item: absoluteUrl(path) }] },
] : []
---
<BaseLayout title={title} description={guide?.answer || 'ไม่พบคู่มือที่ต้องการ'} canonicalPath={path} robots={guide ? 'index,follow,max-image-preview:large' : 'noindex,follow'} jsonLd={schema}>
  <div class="container breadcrumbs"><ol><li><a href="/">หน้าแรก</a></li><li><a href="/guides/">คู่มือเลือกซื้อ</a></li><li>{guide?.title || 'ไม่พบคู่มือ'}</li></ol></div>
  {guide ? <>
    <section class="hero"><div class="container"><h1>{guide.title}</h1><p class="lead">{guide.answer}</p><p class="muted">โดย AMPHON TRADING · เผยแพร่ 6 ตุลาคม 2569 · <a href="/about/">ข้อมูลร้าน</a></p></div></section>
    <section class="section"><article class="container panel editorial-panel">
      <h2>รายการที่ควรเช็กก่อนตัดสินใจ</h2><div class="comparison-scroll"><table class="stock-comparison"><thead><tr><th scope="col">หัวข้อ</th><th scope="col">วิธีตรวจข้อมูล</th></tr></thead><tbody>{guide.checks.map((item) => <tr><th scope="row">{item.item}</th><td>{item.check}</td></tr>)}</tbody></table></div>
      {guide.sections.map((section) => <section><h2>{section.title}</h2>{section.text.map((paragraph) => <p>{paragraph}</p>)}</section>)}
      <h2>คำถามก่อนซื้อ</h2><div class="faq-list">{guide.faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      <h2>ตรวจข้อมูลระบบจากผู้ผลิต</h2>
      <p>สำหรับเครื่อง Windows ให้ตรวจ <a href="https://www.microsoft.com/en-us/windows/windows-11-specifications" target="_blank" rel="noopener">ข้อกำหนด Windows 11 ของ Microsoft</a> ส่วน MacBook ดู <a href="https://support.apple.com/en-us/102888" target="_blank" rel="noopener">วิธีตรวจรอบชาร์จแบตเตอรี่จาก Apple</a> ควบคู่กับผลตรวจของเครื่องจริง</p>
      <h2>เลือกสินค้าจริงจากหมวดที่เกี่ยวข้อง</h2><div class="category-grid">{guide.categories.map((slug) => <a class="category-card" href={`/${slug}/`}><strong>{getCategoryBySlug(slug)?.name || slug}</strong><span>ดูราคา สเปก และสถานะ →</span></a>)}</div>
      <p><a href="/warranty/">การรับประกัน</a> · <a href="/returns/">การคืนสินค้า</a> · <a href="/shipping/">การจัดส่ง</a> · <a href="/how-to-buy/">วิธีสั่งซื้อ</a></p>
    </article></section>
    <BuyingResources categorySlug={guide.categories[0]} />
  </> : <section class="section"><div class="container"><h1>ไม่พบคู่มือ</h1><a href="/guides/">กลับไปเลือกคู่มือ</a></div></section>}
</BaseLayout>
