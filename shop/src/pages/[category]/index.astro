---
import ProductCard from '../../components/ProductCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { catalogCategories, getCategoryBySlug } from '../../config/catalog'
import { getCategorySeoContent } from '../../config/category-seo-content'
import { listEvergreenPages, listStoreProducts, type EvergreenPage, type StoreProduct } from '../../lib/store-api'
import { absoluteUrl, productPath } from '../../lib/seo'

const category = getCategoryBySlug(Astro.params.category)
if (!category) {
  return Astro.redirect('/404/', 302)
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300')

let products: StoreProduct[] = []
let brands: EvergreenPage[] = []
let apiError = false
try {
  const [productResult, brandResult] = await Promise.all([
    listStoreProducts({
      categorySlug: category.slug,
      limit: 48,
    }),
    listEvergreenPages({ pageType: 'BRAND', category: category.slug, effectiveIndexPolicy: 'INDEX', limit: 100 }),
  ])
  products = productResult.products
  brands = brandResult.pages
} catch (error) {
  apiError = true
  console.error('SHOP_CATEGORY_STORE_API', category.key, error)
}

const robots = category.indexPolicy === 'INDEX'
  ? 'index,follow,max-image-preview:large'
  : 'noindex,follow'
const canonicalPath = `/${category.slug}/`
const seoContent = getCategorySeoContent(category.key)
const relatedCategories = (seoContent?.relatedSlugs || [])
  .map((slug) => catalogCategories.find((item) => item.slug === slug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item && item.indexPolicy === 'INDEX'))

const itemList = products.slice(0, 24).map((product, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  url: absoluteUrl(productPath(product)),
  name: product.title,
}))
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: category.h1,
    description: category.description,
    url: absoluteUrl(canonicalPath),
    mainEntity: itemList.length ? { '@type': 'ItemList', itemListElement: itemList } : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: category.name, item: absoluteUrl(canonicalPath) },
    ],
  },
]
---
<BaseLayout title={category.title} description={category.description} canonicalPath={canonicalPath} robots={robots} jsonLd={schema}>
  <div class="container breadcrumbs">
    <ol><li><a href="/">หน้าแรก</a></li><li>{category.name}</li></ol>
  </div>

  <section class="hero category-hero">
    <div class="container">
      <div class="eyebrow">เลือกของที่เหมาะกับคุณ</div>
      <h1>{category.h1}</h1>
      <p class="lead">{seoContent?.hero || 'ดูของที่มีอยู่จริงในร้าน พร้อมราคา รูป และรายละเอียดของแต่ละชิ้น เลือกตัวที่ตรงกับงานและงบได้เลย'}</p>
      <div class="category-hero-status" aria-label="สถานะสินค้าหมวดนี้">
        <span class="category-status-pill">{products.length > 0 ? `ตอนนี้มี ${products.length} รายการ` : 'ของหมวดนี้เข้าเป็นรอบ ๆ'}</span>
        <span>ของมือสองเปลี่ยนเร็ว ถ้าเจอตัวที่ชอบแนะนำเปิดดูรายละเอียดไว้ก่อน</span>
      </div>
    </div>
  </section>

  {brands.length > 0 && (
    <section class="section compact-section">
      <div class="container">
        <div class="section-head human-section-head">
          <div><div class="eyebrow">หาให้ไวขึ้น</div><h2>เลือกตามแบรนด์</h2><p class="muted">ถ้ามีแบรนด์ในใจอยู่แล้ว เริ่มจากตรงนี้ได้เลย</p></div>
        </div>
        <div class="category-grid">
          {brands.map((brand) => <a class="category-card human-category-card" href={brand.canonicalPath}><strong>{brand.brand.name}</strong><span>{brand.currentStockCount > 0 ? `มีของ ${brand.currentStockCount} ชิ้น →` : 'ดูรุ่นของแบรนด์นี้ →'}</span></a>)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head human-section-head">
        <div>
          <div class="eyebrow">ของที่มีตอนนี้</div>
          <h2>{products.length ? 'เลือกจากสินค้าที่พร้อมขาย' : 'ตอนนี้ยังไม่มีของในหมวดนี้'}</h2>
          <p class="muted">{products.length ? `มี ${products.length} รายการ ลองกดดูรูปและรายละเอียดของแต่ละเครื่องได้เลย` : 'ของมือสองเข้าร้านไม่พร้อมกันทุกหมวด แวะกลับมาดูได้เรื่อย ๆ ครับ'}</p>
        </div>
      </div>
      {products.length ? (
        <div class="product-grid">{products.map((product) => <ProductCard product={product} />)}</div>
      ) : (
        <div class="empty human-empty">{apiError ? 'ตอนนี้โหลดรายการสินค้าไม่สำเร็จ ลองรีเฟรชอีกครั้งในอีกสักครู่ครับ' : 'ยังไม่มีของพร้อมขายในหมวดนี้ตอนนี้ แต่หมวดนี้ยังเปิดไว้เพราะมีสินค้าเข้าหมุนเวียนเป็นระยะครับ'}</div>
      )}
    </div>
  </section>

  {seoContent && (
    <section class="section category-commercial-content">
      <div class="container">
        <article class="panel editorial-panel human-buying-guide">
          <div class="eyebrow">เลือกให้ง่ายขึ้น</div>
          <h2>ก่อนซื้อ ลองดู 3 จุดนี้</h2>
          <p class="human-guide-intro">{seoContent.intro}</p>
          <div class="buying-tip-grid">
            {seoContent.buyingPoints.map((point, index) => (
              <div class="buying-tip-card">
                <span class="buying-tip-number">{index + 1}</span>
                <p>{point}</p>
              </div>
            ))}
          </div>
          <p class="human-guide-closing">{seoContent.closing}</p>
        </article>
      </div>
    </section>
  )}

  {relatedCategories.length > 0 && (
    <section class="section category-related-links">
      <div class="container">
        <div class="section-head human-section-head"><div><div class="eyebrow">ยังเลือกไม่ลง?</div><h2>ลองดูหมวดใกล้เคียง</h2><p class="muted">บางทีของที่เหมาะกับงานอาจอยู่คนละหมวดกับที่คิดไว้</p></div></div>
        <div class="category-grid">
          {relatedCategories.map((item) => (
            <a class="category-card human-category-card" href={`/${item.slug}/`}><strong>{item.name}</strong><span>ลองดูต่อ →</span></a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
