---
import EvergreenPageView from '../../../components/EvergreenPage.astro'
import { getCategoryBySlug } from '../../../config/catalog'
import { listEvergreenPages, listStoreProducts, resolveEvergreenPage, type EvergreenPage, type StoreProduct } from '../../../lib/store-api'

const categorySlug = Astro.params.category || ''
const brandSlug = Astro.params.brand || ''
const category = getCategoryBySlug(categorySlug)
if (!category) { Astro.response.status = 404 }

let page: EvergreenPage | null = null
let products: StoreProduct[] = []
let children: EvergreenPage[] = []
try {
  if (category) {
    page = await resolveEvergreenPage({ category: categorySlug, brand: brandSlug })
    if (page) {
      const [productResult, childResult] = await Promise.all([
        listStoreProducts({ categorySlug, brandSlug, limit: 48 }),
        listEvergreenPages({ pageType: 'SERIES', category: categorySlug, brand: brandSlug, effectiveIndexPolicy: 'INDEX', limit: 100 }),
      ])
      products = productResult.products
      children = childResult.pages
    }
  }
} catch (error) { console.error('SHOP2_BRAND_PAGE', categorySlug, brandSlug, error); Astro.response.status = 503 }
if (!page && Astro.response.status !== 503) Astro.response.status = 404
if (page) Astro.response.headers.set('Cache-Control', 'public, s-maxage=120, stale-while-revalidate=600')
---
{page && category ? (
  <EvergreenPageView page={page} products={products} children={children} trail={[
    { name: 'หน้าแรก', path: '/', link: true },
    { name: category.name, path: `/${category.slug}/`, link: true },
    { name: page.brand.name, path: page.canonicalPath, link: false },
  ]} />
) : (
  <html lang="th"><head><meta name="robots" content="noindex" /><title>{Astro.response.status === 503 ? 'ระบบกำลังเชื่อมต่อ' : 'ไม่พบหน้า'}</title></head><body></body></html>
)}
