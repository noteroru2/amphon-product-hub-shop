---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductCard from '../../components/ProductCard.astro'
import StockComparison from '../../components/StockComparison.astro'
import { buyingCollections, guidePath } from '../../config/buying-guides'
import { collectionStock } from '../../lib/buying-collections'
import { getAllStoreProducts } from '../../lib/store-api'
import { absoluteUrl, productPath } from '../../lib/seo'
const collection = buyingCollections.find((item) => item.slug === Astro.params.collection)
if (!collection) Astro.response.status = 404
let stock: ReturnType<typeof collectionStock> = { current: [], sold: [], history: [], indexable: false }
let apiError = false
if (collection) {
  try { stock = collectionStock(await getAllStoreProducts(), collection) }
  catch (error) { apiError = true; Astro.response.status = 503; console.error('SHOP_BUYING_COLLECTION', collection.slug, error) }
}
Astro.response.headers.set('Cache-Control', apiError ? 'no-store' : 'public, s-maxage=60, stale-while-revalidate=300')
const path = collection ? `/collections/${collection.slug}/` : Astro.url.pathname
const title = collection ? `${collection.title} | AMPHON SHOP` : 'ไม่พบหน้าสินค้า | AMPHON SHOP'
const schema = collection ? [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: collection.title, description: collection.intro, url: absoluteUrl(path), mainEntity: { '@type': 'ItemList', itemListElement: stock.current.slice(0, 48).map((product, index) => ({ '@type': 'ListItem', position: index + 1, name: product.title, url: absoluteUrl(productPath(product)) })) } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: absoluteUrl('/') }, { '@type': 'ListItem', position: 2, name: collection.title, item: absoluteUrl(path) }] },
] : []
---
<BaseLayout title={title} description={collection?.intro || 'ไม่พบหน้าสินค้าที่ต้องการ'} canonicalPath={path} robots={!apiError && stock.indexable ? 'index,follow,max-image-preview:large' : 'noindex,follow'} jsonLd={schema}>
  <div class="container breadcrumbs"><ol><li><a href="/">หน้าแรก</a></li><li>{collection?.title || 'ไม่พบหน้า'}</li></ol></div>
  {collection ? <>
    <section class="hero"><div class="container"><h1>{collection.title}</h1><p class="lead">{collection.intro}</p><p>พร้อมขาย {stock.current.length} รายการ · รายการที่เข้าเกณฑ์รวมประวัติ {stock.history.length} รายการ</p><a class="button button-secondary" href={guidePath(collection.guideSlug)}>อ่านวิธีเลือกและจุดที่ต้องตรวจ →</a></div></section>
    <section class="section"><div class="container"><h2>สินค้าที่พร้อมขายตามเกณฑ์นี้</h2>{stock.current.length ? <div class="product-grid">{stock.current.slice(0, 48).map((product) => <ProductCard product={product} />)}</div> : <div class="empty">{apiError ? 'โหลดรายการไม่สำเร็จ กรุณาลองอีกครั้ง' : 'ขณะนี้ยังไม่มีของพร้อมขายตามเกณฑ์นี้ ดูคู่มือหรือเลือกจากหมวดที่เกี่ยวข้องด้านล่างได้'}</div>}</div></section>
    <StockComparison products={[...stock.current, ...stock.sold]} />
    {stock.sold.length > 0 && <section class="section"><div class="container"><h2>รายการเดิม — สินค้าหมด</h2><p class="muted">ดูสเปกและราคาล่าสุดในรายการเพื่อประกอบการเลือก ของพร้อมขายอยู่ด้านบน</p><div class="product-grid">{stock.sold.slice(0, 12).map((product) => <ProductCard product={product} />)}</div></div></section>}
    <section class="section"><div class="container panel editorial-panel"><h2>ดูตัวเลือกอื่นและเงื่อนไขก่อนซื้อ</h2><p>{collection.requireOfficeSpecs ? 'คัดรายการจากสเปกที่บันทึกในหน้าสินค้า หาก RAM หรือ SSD ไม่ชัดเจนจะไม่รวมในหน้านี้ ยืนยันรุ่น CPU และผลตรวจที่จำเป็นกับร้าน' : 'เกณฑ์งบใช้ราคาของรายการปัจจุบัน ทั้งของพร้อมขายและรายการเดิม ราคาของแต่ละชิ้นและสถานะอาจเปลี่ยนแปลงได้'}</p><div class="category-grid">{collection.categories.map((slug) => <a class="category-card" href={`/${slug}/`}><strong>ดูหมวด {slug === 'desktop-pcs' ? 'คอมมือสอง' : slug === 'notebooks' ? 'โน้ตบุ๊กมือสอง' : slug === 'gaming-pcs' ? 'คอมเล่นเกมมือสอง' : slug === 'macbooks' ? 'MacBook มือสอง' : 'Gaming Laptop มือสอง'}</strong><span>ดูรายการทั้งหมด →</span></a>)}</div><p><a href="/warranty/">ประกัน</a> · <a href="/returns/">คืนสินค้า</a> · <a href="/shipping/">ค่าจัดส่ง</a></p></div></section>
  </> : <section class="section"><div class="container"><h1>ไม่พบหน้าสินค้า</h1><a href="/">กลับหน้าร้าน</a></div></section>}
</BaseLayout>
