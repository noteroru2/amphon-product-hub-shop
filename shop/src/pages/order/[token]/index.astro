---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getStoreOrder, type StoreOrder } from '../../../lib/store-api'
import { formatPrice } from '../../../lib/seo'
const token = Astro.params.token || ''
let order: StoreOrder | null = null
try { order = await getStoreOrder(token) } catch (error) { console.error('SHOP5_ORDER', error); Astro.response.status = 503 }
if (!order && Astro.response.status !== 503) Astro.response.status = 404
Astro.response.headers.set('Cache-Control', 'no-store')
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive')
const apiBase = import.meta.env.PUBLIC_AMPHON_STORE_API?.trim().replace(/\/$/, '') || ''
const orderStatusLabel: Record<string,string> = { AWAITING_PAYMENT:'รอชำระเงิน', PAYMENT_REVIEW:'รอตรวจสอบการชำระ', PROCESSING:'กำลังเตรียมสินค้า', SHIPPED:'จัดส่งแล้ว', COMPLETED:'สำเร็จ', CANCELLED:'ยกเลิก', EXPIRED:'หมดเวลาชำระ', REFUNDED:'คืนเงินแล้ว' }
const paymentStatusLabel: Record<string,string> = { UNPAID:'ยังไม่ชำระ', REVIEW:'แจ้งชำระแล้ว รอตรวจสอบ', PAID:'ชำระแล้ว', REFUND_PENDING:'กำลังคืนเงิน', REFUNDED:'คืนเงินแล้ว' }
const statusText = (labels:Record<string,string>, value:string) => labels[value] || 'กำลังอัปเดตสถานะ'
---
<BaseLayout title={order ? `${order.orderNumber} | AMPHON SHOP` : 'สถานะคำสั่งซื้อ | AMPHON SHOP'} description="ตรวจสอบสถานะคำสั่งซื้อ การชำระเงิน การจัดส่ง เอกสาร และประกัน" canonicalPath={Astro.url.pathname} robots="noindex,nofollow">
  <section class="section checkout-shell"><div class="container narrow-container">
    {order ? <div id="order-app" class="panel order-panel" data-api={apiBase} data-token={order.publicToken}>
      <div class="eyebrow">สถานะคำสั่งซื้อ</div><h1 class="checkout-title">{order.orderNumber}</h1>
      <div class="order-status-grid"><div><span>สถานะคำสั่งซื้อ</span><strong>{statusText(orderStatusLabel, order.orderStatus)}</strong></div><div><span>การชำระเงิน</span><strong>{statusText(paymentStatusLabel, order.paymentStatus)}</strong></div></div>
      <div class="order-items">{order.items.map((item) => <div><span>{item.title}<small>รหัสสินค้า {item.sku}</small></span><strong>{formatPrice(item.unitPrice)}</strong></div>)}</div>
      <div class="order-money"><div><span>ค่าสินค้า</span><strong>{formatPrice(order.subtotal)}</strong></div><div><span>ค่าจัดส่ง</span><strong>{formatPrice(order.shippingAmount)}</strong></div><div class="grand"><span>รวม</span><strong>{formatPrice(order.total)}</strong></div></div>
      {order.paymentStatus === 'UNPAID' && order.paymentProvider === 'STRIPE' && order.paymentUrl && <div class="payment-box"><h2>ชำระเงินออนไลน์</h2><p>ดำเนินการชำระเงินผ่านหน้าชำระเงินที่ปลอดภัย แล้วกลับมาตรวจสถานะรายการได้จากหน้านี้</p><a class="button button-primary button-wide" href={order.paymentUrl}>ไปหน้าชำระเงิน</a><p class="microcopy">สงวนสินค้าไว้ถึง {new Date(order.reservationExpiresAt).toLocaleString('th-TH')}</p></div>}
      {order.paymentStatus === 'UNPAID' && order.paymentMethod === 'BANK_TRANSFER' && order.paymentInstructions && <div class="payment-box"><h2>ชำระด้วยการโอนเงิน</h2><p><strong>{order.paymentInstructions.bankName}</strong><br/>{order.paymentInstructions.accountName}<br/><span class="account-number">{order.paymentInstructions.accountNumber}</span></p><p class="microcopy">สงวนสินค้าไว้ถึง <span id="expiry-time">{new Date(order.reservationExpiresAt).toLocaleString('th-TH')}</span></p><form id="payment-notify-form"><label><span>เลขอ้างอิง / หมายเหตุการโอน</span><input name="paymentReference" maxlength="180" /></label><button class="button button-primary button-wide" type="submit">แจ้งว่าโอนเงินแล้ว</button><div id="payment-message"></div></form></div>}
      {order.paymentStatus === 'REVIEW' && <div class="notice">ร้านได้รับการแจ้งชำระแล้วและกำลังตรวจสอบ เมื่อยืนยันยอดแล้วสถานะจะเปลี่ยนเป็น “ชำระแล้ว”</div>}
      {order.paymentStatus === 'PAID' && <div class="notice">ชำระเงินเรียบร้อย ร้านกำลังเตรียมและดำเนินการตามคำสั่งซื้อ</div>}{order.paymentStatus === 'REFUND_PENDING' && <div class="notice">กำลังดำเนินการคืนเงิน กรุณารอติดตามสถานะในหน้านี้</div>}
      {order.trackingNumber && <div class="tracking-box"><strong>เลขติดตาม: {order.trackingNumber}</strong>{order.trackingCarrier && <span>{order.trackingCarrier}</span>}{order.trackingUrl && <a class="inline-link" href={order.trackingUrl} target="_blank" rel="noopener noreferrer">ติดตามพัสดุ</a>}</div>}
      {order.document && <div class="notice">เอกสาร {order.document.number}: <a class="inline-link" href={`/document/${order.document.publicToken}/`}>เปิดเอกสาร</a></div>}
      {!!order.warranties?.length && <div class="notice">ใบรับประกัน: {order.warranties.map((w) => <a class="inline-link" href={`/warranty/${w.publicToken}/`}>{w.certificateNumber}</a>)}</div>}
      <p class="microcopy">สามารถกลับมาเปิดลิงก์นี้เพื่อตรวจสถานะคำสั่งซื้อได้อีกครั้ง</p>
      <div class="hero-actions"><a class="button button-primary" href="/account/orders/">รายการสั่งซื้อของฉัน</a><a class="button button-secondary" href="/">กลับหน้าร้าน</a></div>
    </div> : <div class="empty"><h1>{Astro.response.status === 503 ? 'ไม่สามารถโหลดสถานะคำสั่งซื้อได้' : 'ไม่พบคำสั่งซื้อ'}</h1><p>{Astro.response.status === 503 ? 'กรุณาลองเปิดหน้านี้อีกครั้งในภายหลัง' : 'ลิงก์อาจไม่ถูกต้อง หมดอายุ หรือไม่มีรายการนี้'}</p><a class="button button-primary" href="/">กลับหน้าร้าน</a></div>}
  </div></section>
</BaseLayout>
<script>
  const app = document.getElementById('order-app') as HTMLElement | null
  const form = document.getElementById('payment-notify-form') as HTMLFormElement | null
  const message = document.getElementById('payment-message') as HTMLElement | null
  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!app) return
    const button = form.querySelector('button') as HTMLButtonElement | null
    if (button) { button.disabled = true; button.textContent = 'กำลังแจ้งร้าน...' }
    const data = new FormData(form)
    try {
      const response = await fetch(`${app.dataset.api}/orders/${app.dataset.token}/payment-notify`, { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({ paymentReference: data.get('paymentReference') || '' }) })
      const result = await response.json().catch(() => ({}))
      if (!response.ok) throw new Error(result.error || 'แจ้งชำระไม่สำเร็จ')
      if (message) message.innerHTML = '<div class="notice">แจ้งชำระเงินแล้ว ร้านจะตรวจสอบยอดต่อไป</div>'
      setTimeout(() => location.reload(), 900)
    } catch (error) {
      if (message) message.textContent = error instanceof Error ? error.message : String(error)
      if (button) { button.disabled = false; button.textContent = 'แจ้งว่าโอนเงินแล้ว' }
    }
  })
</script>
