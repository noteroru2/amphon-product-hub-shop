---
import ProductCard from '../components/ProductCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { indexCategories } from '../config/catalog'
import { facebookPageUrl, mainWebsiteUrl, primaryLineId, primaryLineUrl } from '../lib/contact'
import { listStoreProducts, type StoreProduct } from '../lib/store-api'
import { absoluteUrl } from '../lib/seo'

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300')

let products: StoreProduct[] = []
let apiError = false
try {
  const result = await listStoreProducts({ limit: 12 })
  products = result.products
} catch (error) {
  apiError = true
  console.error('SHOP_HOME_STORE_API', error)
}

const title = 'สินค้าไอทีมือสองออนไลน์ | AMPHON TRADING'
const description = 'เลือกซื้อโน้ตบุ๊ก iPhone คอมพิวเตอร์ กล้อง จอคอม และสินค้าไอทีมือสอง พร้อมดูราคา สเปก สภาพ รูปสินค้าจริง และสถานะพร้อมจำหน่ายก่อนสั่งซื้อ'
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'AMPHON SHOP',
    url: absoluteUrl('/'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'OnlineStore',
    name: 'AMPHON TRADING',
    url: absoluteUrl('/'),
    sameAs: [mainWebsiteUrl, facebookPageUrl],
  },
]

const categoryLooks: Record<string, { icon: string; note: string }> = {
  notebooks: { icon: '💻', note: 'เรียน • ทำงาน • พกไปใช้ข้างนอก' },
  'desktop-pcs': { icon: '🖥️', note: 'งานออฟฟิศ • อัปเกรด • เล่นเกม' },
  iphones: { icon: '📱', note: 'ดูรุ่น ความจุ แบต และสภาพเครื่อง' },
  smartphones: { icon: '📲', note: 'Android หลายงบ หลายสเปก' },
  tablets: { icon: '✍️', note: 'เรียน • จดงาน • วาดรูป • ดูหนัง' },
  monitors: { icon: '🖥', note: 'ทำงาน • เกม • ต่อเป็นจอเสริม' },
  cameras: { icon: '📷', note: 'กล้องและอุปกรณ์ถ่ายภาพมือสอง' },
  'gaming-consoles': { icon: '🎮', note: 'เครื่องเกม จอย และชุดพร้อมเล่น' },
}
---
<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={schema}>
  <section class="hero storefront-hero">
    <div class="container storefront-hero-inner">
      <div>
        <div class="eyebrow">AMPHON SHOP</div>
        <h1>สินค้าไอทีมือสองออนไลน์<br />ดูข้อมูลจริงก่อนตัดสินใจ</h1>
        <p class="lead">เลือกของมือสองไม่ควรต้องเดาครับ ที่นี่เราแยกราคา สเปก สภาพ รูปจริง และตำหนิของแต่ละชิ้นไว้ให้ดูตรง ๆ เจอเครื่องที่ถูกใจทักร้านผ่าน LINE ได้เลย</p>
        <div class="hero-actions">
          <a class="button button-line" href={primaryLineUrl} target="_blank" rel="nofollow noopener">สั่งซื้อผ่าน LINE {primaryLineId}</a>
          <a class="button button-secondary" href="#shop-categories">เลือกหมวดสินค้า</a>
        </div>
        <span class="line-hero-note">LINE เป็นช่องทางหลัก • ถ้าสะดวกชำระบนเว็บก็ยังใช้ตะกร้าและ PromptPay / บัตรได้</span>
      </div>
      <aside class="storefront-hero-note" aria-label="วิธีเลือกสินค้า">
        <span class="storefront-note-kicker">เลือกไม่ถูก เริ่มแบบนี้</span>
        <strong>บอกตัวเองก่อนว่าจะเอาไปใช้ทำอะไร</strong>
        <p>จากนั้นค่อยเทียบสเปก สภาพ และงบ ถ้าลังเลระหว่างหลายตัว ส่งรุ่นหรือรหัสสินค้าให้ร้านช่วยดูใน LINE ได้ครับ</p>
      </aside>
    </div>
  </section>

  <section class="home-trust-strip" aria-label="จุดเด่นของร้าน">
    <div class="container home-trust-grid">
      <div class="home-trust-item"><span class="home-trust-icon">👀</span><span><strong>เห็นของก่อนซื้อ</strong><span>รูป สเปก สภาพ และตำหนิของชิ้นนั้นดูได้จากหน้าสินค้า</span></span></div>
      <div class="home-trust-item"><span class="home-trust-icon">💬</span><span><strong>สั่งซื้อผ่าน LINE @webuy เป็นหลัก</strong><span>ส่งรหัสสินค้าให้ร้านเช็กสถานะและคุยรายละเอียดก่อนชำระได้</span></span></div>
      <div class="home-trust-item"><span class="home-trust-icon">💳</span><span><strong>เว็บเป็นทางเลือกสำรอง</strong><span>ลูกค้าที่สะดวกสามารถเข้าตะกร้าและชำระผ่านบัตรหรือ PromptPay บนเว็บได้</span></span></div>
    </div>
  </section>

  <section class="section" id="shop-categories">
    <div class="container">
      <div class="section-head human-section-head">
        <div><div class="eyebrow">กำลังหาอะไรอยู่?</div><h2>เลือกตามของที่อยากได้</h2><p class="muted">กดเข้าหมวดแล้วค่อยไล่ดูของที่มีจริงตอนนี้ได้เลย</p></div>
      </div>
      <div class="category-grid storefront-category-grid">
        {indexCategories.map((category) => {
          const look = categoryLooks[category.slug] || { icon: '•', note: 'ดูสินค้าที่มีในหมวดนี้' }
          return (
            <a class="category-card storefront-category-card" href={`/${category.slug}/`}>
              <span class="storefront-category-icon" aria-hidden="true">{look.icon}</span>
              <strong>{category.name}</strong>
              <span class="storefront-category-note">{look.note}</span>
              <span class="storefront-category-link">เข้าไปดู →</span>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <section class="section storefront-howto">
    <div class="container">
      <div class="section-head human-section-head">
        <div><div class="eyebrow">ดูของมือสองให้สบายใจขึ้น</div><h2>ก่อนซื้อ ลองดู 3 อย่าง</h2></div>
      </div>
      <div class="storefront-step-grid">
        <article class="storefront-step"><span>1</span><strong>ดูว่าเหมาะกับงานไหม</strong><p>ไม่ต้องซื้อสเปกแรงที่สุด เลือกให้พอกับสิ่งที่ใช้จริงจะคุ้มกว่า</p></article>
        <article class="storefront-step"><span>2</span><strong>ซูมดูรูปกับตำหนิ</strong><p>ของมือสองสภาพต่างกันทุกชิ้น รูปจริงช่วยตัดสินใจได้มากกว่าชื่อรุ่น</p></article>
        <article class="storefront-step"><span>3</span><strong>ส่งรหัสสินค้าให้ร้าน</strong><p>ทัก LINE @webuy เพื่อเช็กว่ายังว่าง ถามรายละเอียด หรือให้ร้านช่วยยืนยันของที่ได้และประกันก่อนชำระ</p></article>
      </div>
    </div>
  </section>

  <section class="section" id="latest-products">
    <div class="container">
      <div class="section-head human-section-head">
        <div><div class="eyebrow">ของเพิ่งลงร้าน</div><h2>มีอะไรใหม่ ลองดูก่อน</h2><p class="muted">ของมือสองเปลี่ยนตลอด เจอตัวถูกใจเปิดดูรายละเอียด แล้วส่งรหัสสินค้าให้ร้านทาง LINE ได้เลยครับ</p></div>
      </div>
      {products.length ? (
        <div class="product-grid">{products.map((product) => <ProductCard product={product} />)}</div>
      ) : (
        <div class="empty human-empty">
          {apiError ? 'ตอนนี้โหลดรายการสินค้าไม่สำเร็จ ลองเข้ามาใหม่อีกครั้งในอีกสักครู่ครับ' : 'ตอนนี้ยังไม่มีของใหม่ลงหน้าเว็บ ลองแวะกลับมาดูอีกครั้งครับ'}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
