---
import ProductCard from '../components/ProductCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { indexCategories } from '../config/catalog'
import { listStoreProducts, type StoreProduct } from '../lib/store-api'
import { absoluteUrl } from '../lib/seo'

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300')

let products: StoreProduct[] = []
let apiError = false
try {
  const result = await listStoreProducts({ limit: 12 })
  products = result.products
} catch (error) {
  apiError = true
  console.error('SHOP_HOME_STORE_API', error)
}

const title = 'สินค้าไอทีมือสองออนไลน์ | AMPHON TRADING'
const description = 'เลือกซื้อโน้ตบุ๊ก iPhone คอมพิวเตอร์ กล้อง จอคอม และสินค้าไอทีมือสอง พร้อมดูราคา สเปก สภาพ รูปสินค้าจริง และสถานะพร้อมจำหน่ายก่อนสั่งซื้อ'
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'AMPHON SHOP',
    url: absoluteUrl('/'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'OnlineStore',
    name: 'AMPHON TRADING',
    url: absoluteUrl('/'),
  },
]
---
<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={schema}>
  <section class="hero">
    <div class="container">
      <div class="eyebrow">AMPHON SHOP</div>
      <h1>สินค้าไอทีมือสองออนไลน์<br />ดูข้อมูลจริงก่อนตัดสินใจ</h1>
      <p class="lead">เลือกซื้อโน้ตบุ๊ก คอมพิวเตอร์ iPhone มือถือ กล้อง จอคอม และสินค้าไอที พร้อมดูราคา สเปก สภาพ รูปสินค้าจริง และสถานะพร้อมจำหน่ายก่อนสั่งซื้อ</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/notebooks/">ดูโน้ตบุ๊กมือสอง</a>
        <a class="button button-secondary" href="/iphones/">ดู iPhone มือสอง</a>
      </div>
      <p class="muted">สินค้าทุกชิ้นมีรหัสประจำเครื่อง ตรวจสอบสถานะก่อนยืนยันคำสั่งซื้อ และมีหน้าร้าน AMPHON TRADING</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">หมวดสินค้า</div><h2>เลือกตามประเภทสินค้า</h2></div>
      </div>
      <div class="category-grid">
        {indexCategories.map((category) => (
          <a class="category-card" href={`/${category.slug}/`}>
            <strong>{category.name}</strong>
            <span>ดูสินค้า →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">สินค้าเข้าใหม่</div><h2>สินค้าที่ลงขายล่าสุด</h2></div>
      </div>
      {products.length ? (
        <div class="product-grid">{products.map((product) => <ProductCard product={product} />)}</div>
      ) : (
        <div class="empty">
          {apiError ? 'ไม่สามารถโหลดรายการสินค้าได้ในขณะนี้ กรุณาลองใหม่อีกครั้ง' : 'ยังไม่มีสินค้าที่พร้อมจำหน่ายบนเว็บไซต์'}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
