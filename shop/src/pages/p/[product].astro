---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { primaryLineId, primaryLineUrl } from '../../lib/contact'
import { getStoreProduct, getStoreSettings, listEvergreenPages, listStoreProducts, type EvergreenPage, type StoreProduct, type StoreSettings } from '../../lib/store-api'
import {
  absoluteUrl,
  extractSkuFromProductSegment,
  formatPrice,
  formatThaiDate,
  productDescription,
  productPath,
  productSegment,
} from '../../lib/seo'
import { groupPublicSpecs, imageRoleLabel, productEvidence } from '../../lib/product-trust'
import {
  buildMerchantOrganizationSchema,
  buildProductMerchantSchema,
  merchantAvailabilitySchema,
  merchantItemConditionSchema,
} from '../../lib/merchant-schema'

const segment = Astro.params.product || ''
const sku = extractSkuFromProductSegment(segment)
if (!sku) return Astro.redirect('/404/', 302)

let product: StoreProduct | null | undefined
try {
  product = await getStoreProduct(sku)
} catch (error) {
  console.error('SHOP_PRODUCT_STORE_API', sku, error)
  Astro.response.status = 503
}

if (!product) {
  if (Astro.response.status !== 503) Astro.response.status = 404
}

if (product && segment !== productSegment(product)) {
  return Astro.redirect(productPath(product), 301)
}

let settings: StoreSettings | null = null
if (product) {
  try {
    settings = await getStoreSettings()
  } catch (error) {
    console.error('SHOP3_STORE_SETTINGS', error)
  }
}

let evergreenPages: EvergreenPage[] = []
if (product?.categorySlug && product.catalogBrand?.slug) {
  try {
    const result = await listEvergreenPages({
      category: product.categorySlug,
      brand: product.catalogBrand.slug,
      effectiveIndexPolicy: 'INDEX',
      limit: 100,
    })
    evergreenPages = result.pages
  } catch (error) {
    console.error('SHOP2_PRODUCT_EVERGREEN_TRAIL', product.sku, error)
  }
}
const brandPage = evergreenPages.find((item) => item.pageType === 'BRAND')
const seriesPage = product?.catalogSeries?.slug
  ? evergreenPages.find((item) => item.pageType === 'SERIES' && item.series?.slug === product?.catalogSeries?.slug)
  : undefined
const modelPage = product?.catalogModel?.slug
  ? evergreenPages.find((item) => item.pageType === 'MODEL' && item.model?.slug === product?.catalogModel?.slug)
  : undefined

let relatedProducts: StoreProduct[] = []
if (product) {
  try {
    const filters = product.catalogModel?.slug
      ? { modelSlug: product.catalogModel.slug }
      : product.catalogSeries?.slug
        ? { seriesSlug: product.catalogSeries.slug }
        : product.catalogBrand?.slug
          ? { brandSlug: product.catalogBrand.slug }
          : product.categorySlug
            ? { categorySlug: product.categorySlug }
            : { category: product.category }
    const related = await listStoreProducts({ ...filters, availability: 'available', limit: 9 })
    relatedProducts = related.products.filter((item) => item.sku !== product?.sku).slice(0, 6)
  } catch (error) {
    console.error('SHOP3_RELATED_PRODUCTS', product.sku, error)
  }
}

if (product) Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=180')
else Astro.response.headers.set('Cache-Control', 'no-store')

const canonicalPath = product ? productPath(product) : Astro.url.pathname
const storedSeoTitle = product?.seoTitle?.trim() || ''
const compactStoredSeoTitle = storedSeoTitle.replace(/[\s,฿]/g, '')
const storedSeoTitleHasPrice = product ? compactStoredSeoTitle.includes(String(Math.round(product.price))) : false
const title = product
  ? storedSeoTitle
    ? storedSeoTitleHasPrice
      ? storedSeoTitle
      : `${storedSeoTitle.replace(/\s*\|\s*AMPHON(?: TRADING| SHOP)?\s*$/i, '')} ราคา ${formatPrice(product.price)} | AMPHON TRADING`
    : `${product.title} มือสอง ราคา ${formatPrice(product.price)} | AMPHON TRADING`
  : 'ไม่พบสินค้า | AMPHON SHOP'
const description = product ? productDescription(product) : 'ไม่พบสินค้าที่ต้องการใน AMPHON SHOP'
const socialTitle = product ? `${product.title} • ${formatPrice(product.price)} | AMPHON SHOP` : title
const socialImageAlt = product ? `${product.title} ราคา ${formatPrice(product.price)}` : null
const robots = product && product.indexPolicy !== 'NOINDEX' && product.indexPolicy !== 'HOLD' && product.indexPolicy !== 'RETIRED'
  ? 'index,follow,max-image-preview:large'
  : 'noindex,follow'

const groups = product ? groupPublicSpecs(product) : { core: [], condition: [], accessories: [] }
const allSpecEntries = [...groups.core, ...groups.condition, ...groups.accessories]
const publishedDate = product ? formatThaiDate(product.publishedAt) : null
const updatedDate = product ? formatThaiDate(product.updatedAt) : null
const warrantyDate = product ? formatThaiDate(product.warrantyUntil) : null
const evidence = product ? productEvidence(product) : null
const galleryImages = product
  ? [...product.images].sort((a, b) => Number(b.isCover) - Number(a.isCover) || a.sortOrder - b.sortOrder)
  : []
const primaryImageEntry = galleryImages[0] || null
const primaryImage = primaryImageEntry?.url || null
const primaryImageWidth = primaryImageEntry?.width || null
const primaryImageHeight = primaryImageEntry?.height || null
const defectImages = product?.images.filter((image) => image.role === 'defect') || []
const accessoryImages = product?.images.filter((image) => image.role === 'accessories') || []
const warrantyImages = product?.images.filter((image) => image.role === 'warranty') || []

const breadcrumbItems = product ? [
  { name: 'หน้าแรก', path: '/' },
  ...(product.categorySlug && product.categoryName ? [{ name: product.categoryName, path: `/${product.categorySlug}/` }] : []),
  ...(brandPage ? [{ name: brandPage.brand.name, path: brandPage.canonicalPath }] : []),
  ...(seriesPage ? [{ name: seriesPage.series?.name || '', path: seriesPage.canonicalPath }] : []),
  ...(modelPage ? [{ name: modelPage.model?.name || '', path: modelPage.canonicalPath }] : []),
  { name: product.title, path: canonicalPath },
].filter((item) => item.name) : []

const schema = product ? [
  buildMerchantOrganizationSchema(settings),
  buildProductMerchantSchema({ product, settings, canonicalPath, description, specs: allSpecEntries }),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem', position: index + 1, name: item.name, item: absoluteUrl(item.path),
    })),
  },
] : undefined

const conditionLabel = product ? (() => {
  const value = String(product.merchantItemCondition || 'USED').toUpperCase()
  if (value === 'NEW') return 'สินค้าใหม่'
  if (value === 'REFURBISHED') return 'สินค้าปรับสภาพ'
  return 'สินค้ามือสอง'
})() : ''

const availabilityLabel = product?.availability === 'out_of_stock'
  ? 'ขายแล้ว'
  : product?.availability === 'reserved'
    ? 'มีคนจองแล้ว'
    : 'พร้อมขาย'

const lineUrl = primaryLineUrl
const lineId = primaryLineId
const phone = import.meta.env.PUBLIC_PHONE?.trim() || ''
const phoneHref = phone ? `tel:${phone.replace(/[^+\d]/g, '')}` : ''
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  robots={robots}
  jsonLd={schema}
  ogImage={primaryImage}
  ogImageAlt={socialImageAlt}
  ogImageWidth={primaryImageWidth}
  ogImageHeight={primaryImageHeight}
  ogTitle={socialTitle}
  ogType={product ? 'product' : 'website'}
  productMeta={product ? {
    price: product.price,
    currency: settings?.currency || 'THB',
    availability: merchantAvailabilitySchema(product),
    condition: merchantItemConditionSchema(product),
  } : null}
>
  {product ? (
    <>
      <div class="container breadcrumbs">
        <ol>
          {breadcrumbItems.map((item, index) => <li>{index < breadcrumbItems.length - 1 ? <a href={item.path}>{item.name}</a> : item.name}</li>)}
        </ol>
      </div>

      <div class="container product-detail">
        <section class="gallery product-gallery" data-product-gallery aria-label={`รูปสินค้าจริง ${product.title}`}>
          {galleryImages.length ? (
            <>
              <div class="gallery-stage" data-gallery-stage>
                {galleryImages.length > 1 && (
                  <button class="gallery-nav gallery-prev" type="button" data-gallery-prev aria-label="ดูรูปก่อนหน้า">‹</button>
                )}
                <figure class="product-photo gallery-main-photo">
                  <img
                    src={galleryImages[0].url}
                    alt={`${product.title} ${imageRoleLabel(galleryImages[0].role)}`}
                    loading="eager"
                    decoding="async"
                    data-gallery-main
                  />
                  <figcaption class="gallery-caption">
                    <span data-gallery-role>{imageRoleLabel(galleryImages[0].role)}</span>
                    <span data-gallery-counter>1 / {galleryImages.length}</span>
                  </figcaption>
                </figure>
                {galleryImages.length > 1 && (
                  <button class="gallery-nav gallery-next" type="button" data-gallery-next aria-label="ดูรูปถัดไป">›</button>
                )}
              </div>
              {galleryImages.length > 1 && (
                <div class="gallery-thumbnails" role="list" aria-label="เลือกรูปสินค้า">
                  {galleryImages.map((image, index) => (
                    <button
                      type="button"
                      class:list={['gallery-thumb', index === 0 && 'active']}
                      data-gallery-index={index}
                      data-src={image.url}
                      data-alt={`${product.title} ${imageRoleLabel(image.role)} รูปที่ ${index + 1}`}
                      data-caption={imageRoleLabel(image.role)}
                      aria-label={`ดูรูปที่ ${index + 1}: ${imageRoleLabel(image.role)}`}
                      aria-current={index === 0 ? 'true' : 'false'}
                    >
                      <img src={image.url} alt="" loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
              )}
            </>
          ) : <div class="gallery-placeholder main-photo">ยังไม่มีรูปสินค้า</div>}
        </section>

        <aside class="panel buy-panel">
          <div class="status-row">
            <span class:list={['badge', product.availability !== 'available' && 'badge-reserved']}>{availabilityLabel}</span>
            <span class="trust-pill">{conditionLabel}</span>
          </div>
          <h1 class="product-h1">{product.title}</h1>
          <div class="muted">รหัสสินค้า: {product.sku}</div>

          {(modelPage || seriesPage || brandPage) && <div class="chips taxonomy-links">
            {modelPage && <a class="button button-secondary" href={modelPage.canonicalPath}>ดูสินค้ารุ่น {modelPage.model?.name}</a>}
            {!modelPage && seriesPage && <a class="button button-secondary" href={seriesPage.canonicalPath}>ดูซีรีส์ {seriesPage.series?.name}</a>}
            {!modelPage && !seriesPage && brandPage && <a class="button button-secondary" href={brandPage.canonicalPath}>ดู {brandPage.brand.name} มือสอง</a>}
          </div>}

          <div class="price-large">{formatPrice(product.price)}</div>

          <div class="trust-summary-grid" aria-label="สรุปข้อมูลสินค้า">
            <div><span>สภาพ</span><strong>{product.conditionPercent !== null && product.conditionPercent !== undefined ? `${product.conditionPercent}%` : 'ดูด้านล่าง'}</strong></div>
            <div><span>รูปจริง</span><strong>{evidence?.imageCount || 0} รูป</strong></div>
            <div><span>ประกัน</span><strong>{warrantyDate || 'ยังไม่ระบุ'}</strong></div>
            <div><span>อัปเดตล่าสุด</span><strong>{updatedDate || 'ล่าสุด'}</strong></div>
          </div>

          <div class="chips product-quick-links" aria-label="ไปยังข้อมูลสำคัญของสินค้า">
            <a class="button button-secondary" href="#condition">ดูสภาพ</a>
            <a class="button button-secondary" href="#specs">ดูสเปก</a>
            <a class="button button-secondary" href="#shipping">ส่ง / คืนสินค้า</a>
          </div>

          {product.availability === 'available' && (
            <div class="purchase-actions" aria-label="ช่องทางสั่งซื้อสินค้า">
              <a class="button button-line button-wide line-primary-purchase" href={lineUrl} rel="nofollow noopener" target="_blank">
                สั่งซื้อผ่าน LINE {lineId}
              </a>
              <p class="line-purchase-note">
                ช่องทางหลักของร้าน — ทัก LINE แล้วแจ้งรหัสสินค้า <strong>{product.sku}</strong> เพื่อให้ร้านเช็กสถานะและตอบรายละเอียดก่อนชำระ
              </p>
              {settings?.purchaseEnabled ? (
                <>
                  <button id="add-to-cart" class="button button-secondary button-wide web-purchase-secondary" type="button" data-sku={product.sku}>ใส่ตะกร้า (ชำระผ่านเว็บ)</button>
                  <a class="button button-secondary button-wide web-purchase-secondary" href="/cart/">ไปตะกร้า / ชำระผ่านเว็บ</a>
                  <p id="cart-message" class="microcopy">การชำระผ่านเว็บเป็นทางเลือก ก่อนยืนยัน ร้านจะเช็กว่าสินค้ายังว่างให้อีกครั้ง</p>
                </>
              ) : (
                <>
                  {phoneHref && <a class="button button-secondary button-wide" href={phoneHref}>โทรถามร้าน</a>}
                </>
              )}
            </div>
          )}

          {product.availability === 'reserved' && <div class="notice"><strong>มีลูกค้าจองชิ้นนี้ไว้แล้ว</strong><br />ตอนนี้ยังกดสั่งไม่ได้ หากหลุดจองสถานะจะอัปเดตบนหน้านี้ครับ</div>}
          {product.availability === 'out_of_stock' && <div class="notice"><strong>ชิ้นนี้ขายแล้วครับ</strong><br />ลองดูรุ่นใกล้เคียงที่ยังพร้อมขายด้านล่างได้เลย</div>}

          {publishedDate && <p class="muted product-date">ลงขายเมื่อ {publishedDate}</p>}
        </aside>
      </div>

      <section id="condition" class="section trust-section">
        <div class="container">
          <div class="section-head">
            <div><div class="eyebrow">ดูเครื่องให้ครบ</div><h2>ของชิ้นนี้เป็นยังไงบ้าง</h2></div>
            <p class="muted trust-intro">รวมสภาพ รอยใช้งาน ของที่ได้ และประกันไว้ตรงนี้ จะได้ตัดสินใจก่อนซื้อแบบไม่ต้องเดา</p>
          </div>
          <div class="trust-grid">
            <article class="panel trust-card">
              <h3>สภาพเครื่องและรอยใช้งาน</h3>
              {product.conditionPercent !== null && product.conditionPercent !== undefined && <p><strong>สภาพโดยรวม:</strong> {product.conditionPercent}%</p>}
              {product.defects
                ? <div class="defect-box"><strong>จุดที่ร้านระบุไว้</strong><p>{product.defects}</p></div>
                : <p class="muted">ยังไม่ได้ลงรายละเอียดรอยเพิ่มเติม ลองดูรูปจริงทุกมุมประกอบก่อนตัดสินใจ</p>}
              {defectImages.length > 0 && <p class="evidence-note">มีรูปตำหนิให้ดู {defectImages.length} รูปในแกลเลอรี</p>}
            </article>

            <article class="panel trust-card">
              <h3>ร้านเช็กอะไรไว้บ้าง</h3>
              {groups.condition.length ? <dl class="compact-specs">
                {groups.condition.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}
              </dl> : <p class="muted">ยังไม่มีผลเช็กเพิ่มเติมบนหน้าเว็บ ถ้าอยากให้เช็กจุดไหนก่อนซื้อ ทักร้านได้ครับ</p>}
            </article>

            <article class="panel trust-card">
              <h3>ของที่ได้ไปด้วย</h3>
              {groups.accessories.length ? <dl class="compact-specs">
                {groups.accessories.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}
              </dl> : <p class="muted">ยังไม่ได้ลงรายการอุปกรณ์เพิ่มเติม ถ้าส่วนนี้สำคัญกับคุณ ทักร้านให้ยืนยันก่อนสั่งได้ครับ</p>}
              {accessoryImages.length > 0 && <p class="evidence-note">มีรูปอุปกรณ์ให้ดู {accessoryImages.length} รูปในแกลเลอรี</p>}
            </article>

            <article class="panel trust-card">
              <h3>ประกันเหลือไหม</h3>
              <p>{warrantyDate ? <>มีข้อมูลประกันถึง <strong>{warrantyDate}</strong></> : 'รายการนี้ยังไม่ได้ระบุวันหมดประกัน'}</p>
              {warrantyImages.length > 0 && <p class="evidence-note">มีรูปหลักฐานประกัน {warrantyImages.length} รูป</p>}
              {settings?.warrantyPolicyUrl && <a class="inline-link" href={settings.warrantyPolicyUrl}>ดูเงื่อนไขประกันของร้าน</a>}
            </article>

            <article id="shipping" class="panel trust-card">
              <h3>จัดส่ง / คืนสินค้า</h3>
              {settings?.shipping.enabled ? (
                <p>
                  จัดส่งภายใน {settings.shipping.country || settings.countryCode}
                  {settings.shipping.rate !== null ? <> • ค่าส่ง {settings.shipping.rate === 0 ? 'ฟรี' : formatPrice(settings.shipping.rate)}</> : null}
                  {settings.shipping.transitMinDays !== null && settings.shipping.transitMaxDays !== null ? <> • ใช้เวลาประมาณ {settings.shipping.transitMinDays}–{settings.shipping.transitMaxDays} วัน</> : null}
                </p>
              ) : <p class="muted">ทักร้านเพื่อเช็กค่าจัดส่งได้ก่อนกดสั่งครับ</p>}
              {settings?.returns.enabled ? (
                <p>
                  {settings.returns.category === 'FINITE' && settings.returns.days !== null ? `คืนสินค้าได้ตามเงื่อนไขภายใน ${settings.returns.days} วัน` : settings.returns.category === 'NOT_PERMITTED' ? 'สินค้ารายการนี้ไม่อยู่ในเงื่อนไขรับคืน' : settings.returns.category === 'UNLIMITED' ? 'การคืนสินค้าเป็นไปตามเงื่อนไขของร้าน' : 'การคืนสินค้าเป็นไปตามเงื่อนไขของร้าน'}
                </p>
              ) : <p class="muted">ถ้าต้องการทราบเงื่อนไขคืนสินค้า ทักร้านให้ยืนยันก่อนสั่งได้ครับ</p>}
              <div class="policy-links">
                {settings?.shipping.policyUrl && <a class="inline-link" href={settings.shipping.policyUrl}>ดูรายละเอียดการจัดส่ง</a>}
                {settings?.returns.policyUrl && <a class="inline-link" href={settings.returns.policyUrl}>ดูเงื่อนไขการคืนสินค้า</a>}
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="specs" class="section">
        <div class="container">
          <div class="panel spec-panel">
            <div class="section-head"><div><div class="eyebrow">สเปกเครื่อง</div><h2>รายละเอียดที่ควรรู้</h2></div></div>
            {groups.core.length ? (
              <dl class="spec-list">
                {groups.core.map(([key, value]) => <div class="spec-row"><dt>{key}</dt><dd>{value}</dd></div>)}
              </dl>
            ) : <p class="muted">ยังไม่ได้ลงสเปกเพิ่มเติมสำหรับชิ้นนี้</p>}
          </div>
        </div>
      </section>

      <section class="section disclosure-section">
        <div class="container">
          <div class="panel disclosure-panel">
            <h2>ชอบเครื่องนี้? เช็กอีกนิดก่อนกดสั่ง</h2>
            <p>ของมือสองแต่ละชิ้นไม่เหมือนกัน ลองดูรูปทุกมุม อ่านตำหนิ เช็กของที่ได้และประกันให้ครบ ถ้ามีจุดไหนยังไม่ชัด ทักร้านถามก่อนได้ครับ</p>
            <div class="disclosure-points">
              <span>ดูรูปทุกมุม</span><span>อ่านตำหนิ</span><span>เช็กของที่ได้</span><span>ดูประกัน</span><span>สงสัยตรงไหนถามร้าน</span>
            </div>
          </div>
        </div>
      </section>

      {relatedProducts.length > 0 && <section class="section related-section">
        <div class="container">
          <div class="section-head">
            <div><div class="eyebrow">เผื่ออยากเทียบ</div><h2>{product.availability === 'out_of_stock' ? 'ถ้าชิ้นนี้ขายแล้ว ลองดูตัวเหล่านี้' : 'ถ้ากำลังเทียบ ลองดูตัวเหล่านี้'}</h2></div>
          </div>
          <div class="product-grid">
            {relatedProducts.map((item) => (
              <a class="product-card" href={productPath(item)}>
                <div class="product-image">
                  {item.images[0]?.url ? <img src={item.images[0].url} alt={`${item.title} มือสอง`} loading="lazy" decoding="async" /> : <span class="product-placeholder">ยังไม่มีรูป</span>}
                </div>
                <div class="product-body">
                  <span class="badge">พร้อมขาย</span>
                  <h3 class="product-title">{item.title}</h3>
                  <div class="product-meta">รหัสสินค้า {item.sku}</div>
                  <div class="product-price">{formatPrice(item.price)}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>}
    </>
  ) : (
    <section class="section"><div class="container"><div class="empty"><h1 class="not-found-title">{Astro.response.status === 503 ? 'กำลังโหลดข้อมูลสินค้า' : 'ไม่พบสินค้านี้'}</h1><p>{Astro.response.status === 503 ? 'ตอนนี้โหลดข้อมูลไม่สำเร็จ ลองใหม่อีกครั้งได้ครับ' : 'สินค้านี้อาจขายแล้ว ถูกยกเลิก หรือไม่มีรายการอยู่บนร้านแล้ว'}</p><a class="button button-primary" href="/">กลับหน้าร้าน</a></div></div></section>
  )}
</BaseLayout>

<script>
  import { addCartSku } from '../../lib/cart'
  const button = document.getElementById('add-to-cart') as HTMLButtonElement | null
  const message = document.getElementById('cart-message')
  button?.addEventListener('click', () => {
    const sku = button.dataset.sku || ''
    const cart = addCartSku(sku)
    if (message) message.textContent = `ใส่ตะกร้าแล้ว · ตอนนี้มี ${cart.length} รายการ`
    button.textContent = 'ใส่ตะกร้าแล้ว'
    window.setTimeout(() => { button.textContent = 'ใส่ตะกร้า (ชำระผ่านเว็บ)' }, 1400)
  })

  const gallery = document.querySelector<HTMLElement>('[data-product-gallery]')
  if (gallery) {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]')
    const role = gallery.querySelector<HTMLElement>('[data-gallery-role]')
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]')
    const stage = gallery.querySelector<HTMLElement>('[data-gallery-stage]')
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-index]'))
    const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]')
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]')
    let active = 0

    const selectImage = (index: number) => {
      if (!main || !thumbs.length) return
      active = (index + thumbs.length) % thumbs.length
      const thumb = thumbs[active]
      const src = thumb.dataset.src || ''
      if (src) main.src = src
      main.alt = thumb.dataset.alt || main.alt
      if (role) role.textContent = thumb.dataset.caption || ''
      if (counter) counter.textContent = `${active + 1} / ${thumbs.length}`
      thumbs.forEach((item, itemIndex) => {
        const selected = itemIndex === active
        item.classList.toggle('active', selected)
        item.setAttribute('aria-current', selected ? 'true' : 'false')
      })
      thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' })
    }

    thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => selectImage(index)))
    prev?.addEventListener('click', () => selectImage(active - 1))
    next?.addEventListener('click', () => selectImage(active + 1))

    let touchStartX: number | null = null
    stage?.addEventListener('touchstart', (event) => {
      touchStartX = event.touches[0]?.clientX ?? null
    }, { passive: true })
    stage?.addEventListener('touchend', (event) => {
      if (touchStartX === null) return
      const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX
      const delta = touchEndX - touchStartX
      touchStartX = null
      if (Math.abs(delta) < 45) return
      selectImage(delta < 0 ? active + 1 : active - 1)
    }, { passive: true })
  }
</script>