---
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/auth.css'
---
<BaseLayout title="ลืมรหัสผ่าน | AMPHON SHOP" description="ขอลิงก์ตั้งรหัสผ่านใหม่สำหรับ AMPHON SHOP" canonicalPath="/account/forgot-password/" robots="noindex,nofollow">
  <section class="auth-shell">
    <div class="auth-container">
      <div class="auth-card">
        <div class="eyebrow">RESET PASSWORD</div>
        <h1>ลืมรหัสผ่าน</h1>
        <p class="auth-copy">กรอกอีเมลที่ใช้สมัคร ระบบจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่</p>
        <form id="forgot-form" class="auth-form">
          <label class="auth-field"><span>อีเมล</span><input name="email" type="email" autocomplete="email" required maxlength="180" /></label>
          <button id="forgot-submit" class="button button-primary button-wide auth-button" type="submit">ส่งลิงก์ตั้งรหัสใหม่</button>
        </form>
        <div id="forgot-message" class="auth-message" hidden></div>
        <div class="auth-links"><a class="inline-link" href="/account/login/">กลับไปเข้าสู่ระบบ</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  import { friendlyAuthError, requestCustomerPasswordReset } from '../../lib/customer-auth'
  const form = document.getElementById('forgot-form') as HTMLFormElement
  const submit = document.getElementById('forgot-submit') as HTMLButtonElement
  const message = document.getElementById('forgot-message') as HTMLElement
  const show = (text:string, tone:'error'|'success') => { message.textContent = text; message.className = `auth-message ${tone}`; message.hidden = false }
  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    message.hidden = true
    submit.disabled = true; submit.textContent = 'กำลังส่ง...'
    const email = String(new FormData(form).get('email') || '')
    try {
      const redirectTo = new URL('/account/reset-password/', location.origin).toString()
      await requestCustomerPasswordReset(email, redirectTo)
      show('หากอีเมลนี้มีบัญชีอยู่ ระบบจะส่งลิงก์ตั้งรหัสผ่านใหม่ให้ กรุณาตรวจกล่องจดหมายและ Spam', 'success')
      form.reset()
    } catch (error) {
      show(friendlyAuthError(error), 'error')
    } finally {
      submit.disabled = false; submit.textContent = 'ส่งลิงก์ตั้งรหัสใหม่'
    }
  })
</script>
