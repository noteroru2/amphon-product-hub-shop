---
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/auth.css'
---
<BaseLayout title="ตั้งรหัสผ่านใหม่ | AMPHON SHOP" description="ตั้งรหัสผ่านใหม่สำหรับบัญชี AMPHON SHOP" canonicalPath="/account/reset-password/" robots="noindex,nofollow">
  <section class="auth-shell">
    <div class="auth-container">
      <div class="auth-card">
        <div class="eyebrow">ความปลอดภัยของบัญชี</div>
        <h1>ตั้งรหัสผ่านใหม่</h1>
        <p class="auth-copy">ตั้งรหัสผ่านใหม่อย่างน้อย 8 ตัวอักษร และเลือกคำที่คุณจำได้แต่คาดเดาได้ยาก</p>
        <div id="reset-gate" class="auth-message info">กำลังตรวจสอบลิงก์ตั้งรหัสผ่าน...</div>
        <form id="reset-form" class="auth-form" hidden>
          <label class="auth-field"><span>รหัสผ่านใหม่</span><input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="128" /></label>
          <label class="auth-field"><span>ยืนยันรหัสผ่านใหม่</span><input name="confirmPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="128" /></label>
          <button id="reset-submit" class="button button-primary button-wide auth-button" type="submit">บันทึกรหัสผ่านใหม่</button>
        </form>
        <div id="reset-message" class="auth-message" hidden></div>
        <div class="auth-links"><a class="inline-link" href="/account/forgot-password/">ขอลิงก์ใหม่</a><a class="inline-link" href="/account/login/">กลับไปเข้าสู่ระบบ</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  import { consumeCustomerAuthRedirect, friendlyAuthError, getCustomerUser, updateCustomerPassword } from '../../lib/customer-auth'
  const gate = document.getElementById('reset-gate') as HTMLElement
  const form = document.getElementById('reset-form') as HTMLFormElement
  const submit = document.getElementById('reset-submit') as HTMLButtonElement
  const message = document.getElementById('reset-message') as HTMLElement
  const show = (text:string, tone:'error'|'success'|'info') => { message.textContent = text; message.className = `auth-message ${tone}`; message.hidden = false }
  void (async () => {
    try {
      const result = consumeCustomerAuthRedirect()
      if (result.error) throw new Error(result.error)
      const user = await getCustomerUser()
      if (!user) throw new Error('ลิงก์ตั้งรหัสผ่านหมดอายุ กรุณาขอลิงก์ใหม่')
      gate.hidden = true
      form.hidden = false
    } catch (error) {
      gate.textContent = friendlyAuthError(error)
      gate.className = 'auth-message error'
    }
  })()
  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    message.hidden = true
    const data = new FormData(form)
    const password = String(data.get('password') || '')
    const confirmPassword = String(data.get('confirmPassword') || '')
    if (password.length < 8) { show('กรุณาตั้งรหัสผ่านอย่างน้อย 8 ตัวอักษร', 'error'); return }
    if (password !== confirmPassword) { show('รหัสผ่านทั้งสองช่องไม่ตรงกัน', 'error'); return }
    submit.disabled = true; submit.textContent = 'กำลังบันทึก...'
    try {
      await updateCustomerPassword(password)
      form.reset(); form.hidden = true
      show('เปลี่ยนรหัสผ่านเรียบร้อยแล้ว สามารถเข้าสู่ระบบด้วยรหัสผ่านใหม่ได้ทันที', 'success')
    } catch (error) {
      show(friendlyAuthError(error), 'error')
      submit.disabled = false; submit.textContent = 'บันทึกรหัสผ่านใหม่'
    }
  })
</script>
