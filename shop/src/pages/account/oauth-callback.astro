---
import BaseLayout from '../../layouts/BaseLayout.astro'
import '../../styles/auth.css'
---
<BaseLayout title="กำลังเข้าสู่ระบบ | AMPHON SHOP" description="กำลังตรวจสอบการเข้าสู่ระบบด้วย Google" canonicalPath="/account/oauth-callback/" robots="noindex,nofollow">
  <section class="auth-shell">
    <div class="auth-container">
      <div class="auth-card">
        <div class="eyebrow">เข้าสู่ระบบด้วย Google</div>
        <h1>กำลังตรวจสอบบัญชี</h1>
        <p class="auth-copy">กรุณารอสักครู่ ระบบกำลังยืนยันการเข้าสู่ระบบและจะพาคุณไปหน้าถัดไปโดยอัตโนมัติ</p>
        <div id="oauth-message" class="auth-message info">กำลังตรวจสอบบัญชี...</div>
        <div id="oauth-actions" class="auth-actions" hidden>
          <a class="button button-primary button-wide" href="/account/login/">ลองเข้าสู่ระบบอีกครั้ง</a>
          <a class="button button-secondary button-wide" href="/account/">บัญชีของฉัน</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  import { clearPendingCustomerOAuth, consumeCustomerAuthRedirect, friendlyAuthError, getCustomerUser, readPendingCustomerOAuth } from '../../lib/customer-auth'
  const message = document.getElementById('oauth-message') as HTMLElement
  const actions = document.getElementById('oauth-actions') as HTMLElement
  const pending = readPendingCustomerOAuth()
  const result = consumeCustomerAuthRedirect()
  const fail = (text:string) => {
    message.textContent = text
    message.className = 'auth-message error'
    actions.hidden = false
    clearPendingCustomerOAuth()
  }
  if (result.error) {
    fail(friendlyAuthError(new Error(result.error)))
  } else {
    void getCustomerUser().then((user) => {
      if (!user) {
        fail('ไม่สามารถยืนยันการเข้าสู่ระบบได้ กรุณาลองเข้าสู่ระบบด้วย Google อีกครั้ง')
        return
      }
      message.textContent = pending.mode === 'link' ? 'เชื่อม Google กับบัญชีเรียบร้อยแล้ว' : 'เข้าสู่ระบบด้วย Google สำเร็จ'
      message.className = 'auth-message success'
      const next = pending.next
      clearPendingCustomerOAuth()
      setTimeout(() => { location.replace(next) }, 450)
    }).catch((error) => fail(friendlyAuthError(error)))
  }
</script>
