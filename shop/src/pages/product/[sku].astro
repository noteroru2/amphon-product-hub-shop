---
// Backward-compatible product URL. Canonical product pages live under /p/.
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getStoreProduct } from '../../lib/store-api'
import { productPath } from '../../lib/seo'

const sku = String(Astro.params.sku || '').trim().toUpperCase()
if (!sku) return Astro.redirect('/404/', 302)

try {
  const product = await getStoreProduct(sku)
  if (!product) return Astro.redirect('/404/', 302)
  return Astro.redirect(productPath(product), 301)
} catch (error) {
  console.error('SHOP_LEGACY_PRODUCT_REDIRECT', sku, error)
  Astro.response.status = 503
}
---
<BaseLayout title="กำลังโหลดข้อมูลสินค้า | AMPHON SHOP" description="ไม่สามารถโหลดข้อมูลสินค้าได้ในขณะนี้" canonicalPath={Astro.url.pathname} robots="noindex,nofollow">
  <section class="section"><div class="container"><div class="empty">
    <h1 class="not-found-title">ไม่สามารถโหลดข้อมูลสินค้าได้</h1>
    <p>กรุณาลองเปิดหน้านี้อีกครั้ง หรือกลับไปเลือกสินค้าจากหน้าร้าน</p>
    <a class="button button-primary" href="/">กลับหน้าร้าน</a>
  </div></div></section>
</BaseLayout>
