{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amphon-shop",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "shop.amphon.co.th",
      "custom_domain": true
    }
  ]
}
